# Secrets & local config — never bake into image.
# Unlike .gitignore, bare .dockerignore patterns match only at the context root; **/ matches at any depth.
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p12

# Version control
.git
.gitignore

# Python artifacts
__pycache__/
*.pyc
*.pyo
.venv/

# Node artifacts
node_modules/
frontend/dist/
.vite/

# Local databases
*.db
*.sqlite

# Tests (not needed at runtime)
tests/
backend/tests/

# Dev tooling & docs
scripts/
.github/
docs/
*.md
!README.md

# Credential / beads files
.dolt/
.beads/
.beads-credential-key
